// Lignum Gestão — schema Prisma (single-tenant)
// Media → URLs armazenadas (Vercel Blob) em campos String / String[] / Json

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  admin
  vendedor
  financeiro
  producao
  read_only
}

enum AuditAction {
  login_success
  login_failure
  user_created
  user_updated
  user_deactivated
  user_reactivated
  user_role_changed
  user_password_reset
  erp_setting_updated
}

enum QuoteStatus {
  rascunho
  enviado
  aprovado
  convertido
  cancelado
}

enum UsedBodyStatus {
  disponivel
  reservada
  vendida
  em_reforma
}

enum UsedBodyCondition {
  excelente
  bom
  regular
  ruim
}

enum MaterialCategory {
  madeira
  ferragens
  tintas
  estrutura
  tampa
  assoalho
  acabamento
  consumivel
  opcional
}

enum StockMovementType {
  entrada
  saida
  estorno
}

enum ProductionOrderStatus {
  aguardando
  andamento
  concluida
  cancelada
}

enum BodyCoverStyle {
  tampa_plana
  tampa_arqueada
  tampa_basculante
}

enum BodyFloorType {
  assoalho_madeira
  assoalho_aco
  assoalho_aluminio
}

enum BodyFinishType {
  pintura
  verniz
  lamina_natural
}

enum PayableStatus {
  aberta
  paga
  vencida
  cancelada
}

enum PersonType {
  pf @map("PF")
  pj @map("PJ")
}

enum PayableOrigin {
  manual
  outro
}

enum FinanceEventType {
  payable_due
}

/// Utilizador da aplicação.
model User {
  id                           Int       @id @default(autoincrement())
  email                        String    @unique
  passwordHash                 String    @map("password_hash")
  name                         String?
  role                         Role      @default(vendedor)
  isActive                     Boolean   @default(true) @map("is_active")
  lgpdConsentVersion           String?   @map("lgpd_consent_version")
  lgpdConsentAt                DateTime? @map("lgpd_consent_at")
  showDashboardAttentionStripe Boolean   @default(true) @map("show_dashboard_attention_stripe")
  financeEventNotifyDaysBeforeOverride Int? @map("finance_event_notify_days_before_override")
  sessionRevokedAt             DateTime? @map("session_revoked_at")
  createdAt                    DateTime  @default(now()) @map("created_at")
  updatedAt                    DateTime  @updatedAt @map("updated_at")

  notifications              UserNotification[]
  documentLookupAudits       DocumentLookupAudit[]
  auditLogs                  AuditLog[]
  financeNotificationDispatches FinanceNotificationDispatch[]
  quotesCreated              Quote[] @relation("QuoteCreator")
  usedBodyStatusChanges      UsedBodyStatusHistory[]
  stockMovementsCreated      StockMovement[]         @relation("StockMovementCreator")
  employee                   Employee?

  @@map("users")
}

model AuditLog {
  id           Int         @id @default(autoincrement())
  userId       Int?        @map("user_id")
  user         User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  action       AuditAction
  resourceType String      @map("resource_type")
  resourceId   String?     @map("resource_id")
  metadata     Json        @default("{}")
  createdAt    DateTime    @default(now()) @map("created_at")

  @@index([userId, createdAt])
  @@index([action, createdAt])
  @@index([resourceType, createdAt])
  @@map("audit_logs")
}

model Client {
  id                 Int         @id @default(autoincrement())
  documentId         String?     @unique @map("document_id")
  fullName           String      @map("full_name")
  document           String
  email              String
  phone              String?
  address            String?
  personType         PersonType? @map("person_type")
  rg                 String?
  maritalStatus      String?     @map("marital_status")
  profession         String?
  zipCode            String?     @map("zip_code")
  nationality        String?
  neighborhood       String?
  street             String?
  city               String?
  streetNumber       String?     @map("street_number")
  addressComplement  String?     @map("address_complement")
  birthDate          DateTime?   @map("birth_date") @db.Date
  registrationStatus String?     @map("registration_status")
  createdAt          DateTime    @default(now()) @map("created_at")
  updatedAt          DateTime    @updatedAt @map("updated_at")

  documents      ClientDocument[]
  quotes         Quote[]

  @@index([document])
  @@index([email])
  @@map("clients")
}

model ClientDocument {
  id              Int       @id @default(autoincrement())
  documentId      String?   @unique @map("document_id")
  title           String
  notes           String?
  externalUrl     String?   @map("external_url")
  documentFileUrl String?   @map("document_file_url")
  clientId        Int       @map("client_id")
  client          Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  @@index([clientId])
  @@map("client_documents")
}

model Supplier {
  id                  Int       @id @default(autoincrement())
  documentId          String?   @unique @map("document_id")
  companyName         String    @map("company_name")
  document            String?
  phone               String?
  email               String?
  notes               String?
  zipCode             String?   @map("zip_code")
  neighborhood        String?
  street              String?
  city                String?
  streetNumber        String?   @map("street_number")
  addressComplement   String?   @map("address_complement")
  registrationStatus  String?   @map("registration_status")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  payables          Payable[]
  usedBodies        UsedBody[]
  materials         Material[]

  @@index([companyName])
  @@map("suppliers")
}

model Payable {
  id          Int          @id @default(autoincrement())
  documentId  String?      @unique @map("document_id")
  origin      PayableOrigin
  description String       @default("")
  dueDate     DateTime     @map("due_date") @db.Date
  amount      Decimal      @db.Decimal(14, 2)
  status      PayableStatus @default(aberta)
  paymentDate DateTime?    @map("payment_date") @db.Date
  notes       String?

  supplierId  Int?         @map("supplier_id")
  supplier    Supplier?    @relation(fields: [supplierId], references: [id], onDelete: SetNull)

  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  @@index([dueDate])
  @@index([status])
  @@index([origin])
  @@index([supplierId])
  @@map("payables")
}

/// Notificações in-app.
model UserNotification {
  id           Int       @id @default(autoincrement())
  documentId   String?   @unique @map("document_id")
  title        String
  body         String
  read         Boolean   @default(false)
  link         String?
  remindAt     DateTime? @map("remind_at")
  ownerUserId  Int       @map("owner_user_id")
  owner        User      @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  @@index([ownerUserId])
  @@index([read])
  @@index([remindAt])
  @@map("user_notifications")
}

/// Registo de dispatch para idempotência (avisos financeiros).
model FinanceNotificationDispatch {
  id           Int            @id @default(autoincrement())
  eventType    FinanceEventType @map("event_type")
  eventId      Int            @map("event_id")
  ownerUserId  Int            @map("owner_user_id")
  owner        User           @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  scheduledFor DateTime       @map("scheduled_for")
  sentAt       DateTime?      @map("sent_at")
  cancelledAt  DateTime?      @map("cancelled_at")
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")

  @@unique([eventType, eventId, ownerUserId, scheduledFor])
  @@index([ownerUserId])
  @@index([scheduledFor])
  @@map("finance_notification_dispatches")
}

/// Configuração da fábrica — singleton (id = 1).
model ErpSetting {
  id                       Int      @id @default(1)
  companyName              String   @default("") @map("company_name")
  companyTaxId             String   @default("") @map("company_tax_id")
  companyStateReg          String   @default("") @map("company_state_reg")
  companyAddress           String   @default("") @map("company_address")
  companyCity              String   @default("") @map("company_city")
  companyState             String   @default("") @map("company_state")
  companyZip               String   @default("") @map("company_zip")
  companyPhone             String   @default("") @map("company_phone")
  companyEmail             String   @default("") @map("company_email")
  alertDocsEnabled         Boolean  @default(true) @map("alert_docs_enabled")
  alertEmailDigestEnabled  Boolean  @default(true) @map("alert_email_digest_enabled")
  financeEventNotifyDaysBefore Int  @default(1) @map("finance_event_notify_days_before")
  inboxPreEventPopupMinutes Int     @default(30) @map("inbox_pre_event_popup_minutes")
  quotePricingJson         Json     @default("{}") @map("quote_pricing_json")
  updatedAt                DateTime @updatedAt @map("updated_at")

  @@map("erp_settings")
}

/// Modelo base de carroceria (catálogo paramétrico).
model BodyModel {
  id          Int      @id @default(autoincrement())
  documentId  String?  @unique @map("document_id")
  name        String
  description String?
  basePrice   Decimal  @db.Decimal(14, 2) @map("base_price")
  pricePerM2  Decimal  @default(0) @db.Decimal(14, 2) @map("price_per_m2")
  active      Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  quotes Quote[]

  @@map("body_models")
}

/// Orçamento comercial de carroceria.
model Quote {
  id              Int             @id @default(autoincrement())
  documentId      String?         @unique @map("document_id")
  quoteNumber     String?         @unique @map("quote_number")
  status          QuoteStatus     @default(rascunho)
  clientId        Int             @map("client_id")
  client          Client          @relation(fields: [clientId], references: [id], onDelete: Restrict)
  bodyModelId     Int?            @map("body_model_id")
  bodyModel       BodyModel?      @relation(fields: [bodyModelId], references: [id], onDelete: SetNull)
  lengthM         Decimal         @db.Decimal(8, 2) @map("length_m")
  widthM          Decimal         @db.Decimal(8, 2) @map("width_m")
  heightM         Decimal         @db.Decimal(8, 2) @map("height_m")
  coverStyle      BodyCoverStyle  @map("cover_style")
  floorType       BodyFloorType   @map("floor_type")
  finishType      BodyFinishType  @map("finish_type")
  optionsJson     Json            @default("[]") @map("options_json")
  subtotal        Decimal         @db.Decimal(14, 2)
  discount        Decimal         @default(0) @db.Decimal(14, 2)
  total           Decimal         @db.Decimal(14, 2)
  marginPercent   Decimal?        @db.Decimal(5, 2) @map("margin_percent")
  paymentTerms    String?         @map("payment_terms")
  deliveryDays    Int?            @map("delivery_days")
  notes           String?
  validUntil      DateTime?       @map("valid_until") @db.Date
  approvedAt      DateTime?       @map("approved_at")
  convertedAt     DateTime?       @map("converted_at")
  createdByUserId Int?            @map("created_by_user_id")
  createdBy       User?           @relation("QuoteCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  items           QuoteItem[]
  technicalSheet  TechnicalSheet?
  productionOrder ProductionOrder?
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")

  @@index([status])
  @@index([clientId])
  @@map("quotes")
}

/// Linha de item calculada ou manual do orçamento.
model QuoteItem {
  id          Int     @id @default(autoincrement())
  quoteId     Int     @map("quote_id")
  quote       Quote   @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  sortOrder   Int     @default(0) @map("sort_order")
  itemType    String  @map("item_type")
  description String
  quantity    Decimal @db.Decimal(14, 4)
  unit        String  @default("un")
  unitPrice   Decimal @db.Decimal(14, 2) @map("unit_price")
  totalPrice  Decimal @db.Decimal(14, 2) @map("total_price")

  @@index([quoteId])
  @@map("quote_items")
}

/// Ficha técnica / BOM gerada a partir de orçamento aprovado.
model TechnicalSheet {
  id          Int      @id @default(autoincrement())
  documentId  String?  @unique @map("document_id")
  quoteId     Int      @unique @map("quote_id")
  quote       Quote    @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  sheetNumber String?  @map("sheet_number")
  bomJson     Json     @map("bom_json")
  notes       String?
  productionOrder ProductionOrder?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("technical_sheets")
}

/// Auditoria de consultas CNPJ cadastrais.
model DocumentLookupAudit {
  id                 Int      @id @default(autoincrement())
  userId             Int      @map("user_id")
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  documentNormalized String   @map("document_normalized")
  documentKind       String   @map("document_kind")
  provider           String
  cost               Decimal  @db.Decimal(14, 4)
  success            Boolean
  errorCode          String?  @map("error_code")
  cachedResponse     Boolean  @default(false) @map("cached_response")
  snapshotJson       Json     @map("snapshot_json")
  createdAt          DateTime @default(now()) @map("created_at")

  @@index([userId, createdAt])
  @@index([createdAt])
  @@map("document_lookup_audits")
}

/// Carroceria seminova/usada (domínio Lignum).
model UsedBody {
  id           Int               @id @default(autoincrement())
  documentId   String?           @unique @map("document_id")
  title        String
  lengthM      Decimal           @map("length_m") @db.Decimal(8, 2)
  widthM       Decimal           @map("width_m") @db.Decimal(8, 2)
  heightM      Decimal?          @map("height_m") @db.Decimal(8, 2)
  condition    UsedBodyCondition
  entryValue   Decimal           @map("entry_value") @db.Decimal(14, 2)
  saleValue    Decimal?          @map("sale_value") @db.Decimal(14, 2)
  status       UsedBodyStatus    @default(disponivel)
  observations String?
  mainPhotoUrl String?           @map("main_photo_url")
  galleryUrls  String[]          @default([]) @map("gallery_urls")
  supplierId   Int?              @map("supplier_id")
  supplier     Supplier?         @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  createdAt    DateTime          @default(now()) @map("created_at")
  updatedAt    DateTime          @updatedAt @map("updated_at")

  statusHistory UsedBodyStatusHistory[]

  @@index([status])
  @@map("used_bodies")
}

/// Histórico de transições de status de carroceria usada.
model UsedBodyStatusHistory {
  id              Int             @id @default(autoincrement())
  usedBodyId      Int             @map("used_body_id")
  usedBody        UsedBody        @relation(fields: [usedBodyId], references: [id], onDelete: Cascade)
  fromStatus      UsedBodyStatus? @map("from_status")
  toStatus        UsedBodyStatus  @map("to_status")
  changedByUserId Int?            @map("changed_by_user_id")
  changedBy       User?           @relation(fields: [changedByUserId], references: [id], onDelete: SetNull)
  notes           String?
  createdAt       DateTime        @default(now()) @map("created_at")

  @@index([usedBodyId])
  @@map("used_body_status_history")
}

/// Matéria-prima / insumo de produção.
model Material {
  id           Int              @id @default(autoincrement())
  documentId   String?          @unique @map("document_id")
  sku          String           @unique
  name         String
  category     MaterialCategory
  unit         String
  minStock     Decimal          @default(0) @map("min_stock") @db.Decimal(14, 4)
  avgCost      Decimal          @default(0) @map("avg_cost") @db.Decimal(14, 2)
  currentStock Decimal          @default(0) @map("current_stock") @db.Decimal(14, 4)
  supplierId   Int?             @map("supplier_id")
  supplier     Supplier?        @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  movements    StockMovement[]
  createdAt    DateTime         @default(now()) @map("created_at")
  updatedAt    DateTime         @updatedAt @map("updated_at")

  @@index([category])
  @@index([sku])
  @@map("materials")
}

/// Movimentação de estoque (entrada, saída manual ou automática, estorno).
model StockMovement {
  id                Int               @id @default(autoincrement())
  materialId        Int               @map("material_id")
  material          Material          @relation(fields: [materialId], references: [id], onDelete: Cascade)
  type              StockMovementType
  quantity          Decimal           @db.Decimal(14, 4)
  unitCost          Decimal?          @map("unit_cost") @db.Decimal(14, 2)
  productionOrderId Int?              @map("production_order_id")
  productionOrder   ProductionOrder?  @relation(fields: [productionOrderId], references: [id], onDelete: SetNull)
  notes             String?
  createdByUserId   Int?              @map("created_by_user_id")
  createdBy         User?             @relation("StockMovementCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  createdAt         DateTime          @default(now()) @map("created_at")

  @@index([materialId])
  @@index([createdAt])
  @@index([productionOrderId])
  @@map("stock_movements")
}

/// Ordem de produção vinculada a orçamento convertido.
model ProductionOrder {
  id               Int                   @id @default(autoincrement())
  documentId       String?               @unique @map("document_id")
  orderNumber      String?               @unique @map("order_number")
  quoteId          Int                   @unique @map("quote_id")
  quote            Quote                 @relation(fields: [quoteId], references: [id], onDelete: Restrict)
  technicalSheetId Int                   @unique @map("technical_sheet_id")
  technicalSheet   TechnicalSheet        @relation(fields: [technicalSheetId], references: [id], onDelete: Restrict)
  status           ProductionOrderStatus @default(aguardando)
  startedAt        DateTime?             @map("started_at")
  completedAt      DateTime?             @map("completed_at")
  cancelledAt      DateTime?             @map("cancelled_at")
  photoUrls        String[]              @default([]) @map("photo_urls")
  notes            String?
  employees        ProductionOrderEmployee[]
  stockMovements   StockMovement[]
  createdAt        DateTime              @default(now()) @map("created_at")
  updatedAt        DateTime              @updatedAt @map("updated_at")

  @@index([status])
  @@map("production_orders")
}

/// Vínculo N:N ordem de produção ↔ funcionário.
model ProductionOrderEmployee {
  productionOrderId Int             @map("production_order_id")
  productionOrder   ProductionOrder @relation(fields: [productionOrderId], references: [id], onDelete: Cascade)
  employeeId        Int             @map("employee_id")
  employee          Employee        @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  assignedAt        DateTime        @default(now()) @map("assigned_at")

  @@id([productionOrderId, employeeId])
  @@index([employeeId])
  @@map("production_order_employees")
}

/// Funcionário da produção (pode vincular a utilizador do sistema).
model Employee {
  id             Int       @id @default(autoincrement())
  documentId     String?   @unique @map("document_id")
  name           String
  roleTitle      String    @map("role_title")
  commissionPct  Decimal?  @map("commission_pct") @db.Decimal(5, 2)
  isActive       Boolean   @default(true) @map("is_active")
  userId         Int?      @unique @map("user_id")
  user           User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  productionOrders ProductionOrderEmployee[]
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  @@index([isActive])
  @@map("employees")
}

/// Lead CRM (single-tenant).
model StorefrontLead {
  id          Int       @id @default(autoincrement())
  name        String
  email       String
  phone       String
  message     String?
  source      String    @default("crm")
  consentText String    @map("consent_text")
  consentAt   DateTime  @map("consent_at")
  readAt      DateTime? @map("read_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  @@index([createdAt])
  @@index([readAt])
  @@map("storefront_leads")
}
